{
  "permissions": {
    "allow": [
      "mcp__brave-search__brave_web_search",
      "mcp__tavily__tavily_search",
      "mcp__exa__web_search_exa",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__filesystem__write_file",
      "Bash(make lint:*)",
      "Bash(make build:*)",
      "Bash(find:*)",
      "Bash(swift build:*)",
      "mcp__code-index__search_code_advanced",
      "mcp__code-index__set_project_path",
      "mcp__code-index__find_files",
      "mcp__filesystem__directory_tree"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/inject-date.sh"
          },
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/ios26-context.sh"
          },
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/makefile-suggest.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(Edit|Write).*\\.swift$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/swift6-concurrency-check.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/code-quality-validator.sh"
          }
        ]
      },
      {
        "matcher": "Bash.*git commit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/pre-commit-validate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Edit|Write).*\\.swift$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/coverage-aware-test.sh"
          }
        ]
      },
      {
        "matcher": "Edit.*\\.swift$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/keiran/.claude/hooks/post-edit-test.sh"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}
